# Build the WibuScript core once, then ship only the runtime artifacts.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.build.json ./
COPY scripts ./scripts
COPY src ./src
RUN npm run core:build
RUN npm prune --omit=dev

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=65532:65532 /app/dist ./dist
COPY --from=build --chown=65532:65532 /app/node_modules ./node_modules
COPY --chown=65532:65532 scripts/container-runner.mjs ./scripts/container-runner.mjs
USER 65532:65532
ENTRYPOINT ["node", "/app/scripts/container-runner.mjs"]
