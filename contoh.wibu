// Contoh Program WibuScript (.wibu) - 4 Dialek Mutlak
kore ksatria = "Ren"
zettai level = 99
kore isHero = hontou
kore inventaris = ["Pedang Excalibur", "Ramuan Mana", "Batu Sihir"]

mite(`Memulai petualangan WibuScript bersama ${ksatria}...`)
mite(`Senjata utama: ${inventaris[0]}`)

moshi (ksatria == "Ren" && isHero == hontou) {
    mite(`Selamat datang kembali, ${ksatria}!`)
    mite(`Level kamu saat ini: ${level}`)
} hoka {
    mite("Identitas tidak dikenali.")
}

jutsu hitungBonus(lvl) {
    moshi (lvl >= 50) {
        kaesu lvl * 10
    }
    kaesu lvl * 2
}

kore totalSkor = hitungBonus(level)
mite(`Total bonus diperoleh: ${totalSkor}`)

kokoromi {
    mite("Mencoba validasi integritas sihir...")
    kore uji = 100 / 2
    mite(`Hasil perhitungan validasi: ${uji}`)
} yurusu (err) {
    mite(`Peringatan galat: ${err}`)
}

// Demonstrasi Phase 3: Destructuring & Shougo Pattern Matching
kore [senjataSatu, ...cadangan] = inventaris;
mite(`Senjata utama hasil destructuring: ${senjataSatu}`);
mite(`Jumlah item cadangan: ${cadangan.nagasa}`);

kore role = "Ksatria";
shougo (role) {
    baai "Penyihir": {
        mite("Role: Menguasai sihir tingkat tinggi.");
    }
    baai "Ksatria": {
        mite("Role: Pelindung garis depan kerajaan!");
    }
    hyoujun: {
        mite("Role: Petualang pemula.");
    }
}

mite("Petualangan WibuScript berhasil dijalankan!")
