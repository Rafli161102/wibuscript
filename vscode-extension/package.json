{
  "name": "wibuscript-lang",
  "displayName": "WibuScript Language Support",
  "description": "Syntax Highlighting resmi untuk bahasa pemrograman WibuScript",
  "version": "1.0.0",
  "publisher": "wibuscript-opensource",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "wibuscript",
        "aliases": [
          "WibuScript",
          "wibuscript"
        ],
        "extensions": [
          ".wibu"
        ]
      }
    ],
    "grammars": [
      {
        "language": "wibuscript",
        "scopeName": "source.wibuscript",
        "path": "./syntaxes/wibuscript.tmLanguage.json"
      }
    ]
  }
}
