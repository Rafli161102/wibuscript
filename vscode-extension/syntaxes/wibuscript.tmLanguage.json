{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WibuScript",
  "scopeName": "source.wibuscript",
  "fileTypes": ["wibu"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-function" },
    { "include": "#keywords-io" },
    { "include": "#keywords-stdlib" },
    { "include": "#keywords-operator" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wibuscript",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wibuscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wibuscript",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.wibuscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.wibuscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.wibuscript",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.wibuscript",
          "match": "\\b(majiBener|maji)\\b"
        },
        {
          "name": "constant.language.boolean.false.wibuscript",
          "match": "\\b(usoBanget|uso)\\b"
        },
        {
          "name": "constant.language.null.wibuscript",
          "match": "\\b(kosongZannen|karappo|kara|mu)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.conditional.wibuscript",
          "match": "\\b(kaloMoshi|moshi|soreTomo|tomo|hokaNo|hoka|chigauBener|chigau)\\b"
        },
        {
          "name": "keyword.control.loop.wibuscript",
          "match": "\\b(ulangZutto|zutto)\\b"
        },
        {
          "name": "keyword.control.break.wibuscript",
          "match": "\\b(berhentiDuluKudasai|tomare)\\b"
        },
        {
          "name": "keyword.control.continue.wibuscript",
          "match": "\\b(lanjutAksiSugi|tsugi)\\b"
        },
        {
          "name": "keyword.control.return.wibuscript",
          "match": "\\b(balikinDesu|modoru)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.variable.wibuscript",
          "match": "\\b(koreWa|kore)\\b"
        }
      ]
    },
    "keywords-function": {
      "patterns": [
        {
          "name": "keyword.declaration.function.wibuscript",
          "match": "\\b(bikinJutsu|jutsu)\\b"
        }
      ]
    },
    "keywords-io": {
      "patterns": [
        {
          "name": "support.function.io.wibuscript",
          "match": "\\b(kasihMite|mite|print)\\b"
        }
      ]
    },
    "keywords-stdlib": {
      "patterns": [
        {
          "name": "support.function.delay.wibuscript",
          "match": "\\b(tungguBentarKudasai|tungguBentar|mate)\\b"
        },
        {
          "name": "support.function.time.wibuscript",
          "match": "\\b(sekarangImaDesu|imaDesu|ima|waktuSekarang)\\b"
        },
        {
          "name": "support.function.length.wibuscript",
          "match": "\\b(tolongCekNagasa|cekNagasa|nagasa|panjangTeks)\\b"
        },
        {
          "name": "support.function.conversion.wibuscript",
          "match": "\\b(bikinJadiSuji|jadiSuji|sujiNi|ubahAngka)\\b"
        },
        {
          "name": "support.function.typeof.wibuscript",
          "match": "\\b(apaTipeKoreWa|tipeNani|shurui)\\b"
        },
        {
          "name": "support.function.math.wibuscript",
          "match": "\\b(kalkulasiPangkatSuji|pangkatSuji|beki|bikinBulatSuji|bulatSuji|marume)\\b"
        },
        {
          "name": "support.function.array.wibuscript",
          "match": "\\b(masukinKeRetsu|isiRetsu|tsuika|keluarinDariRetsu|buangRetsu|sakujo|bikinRetsu|retsu)\\b"
        },
        {
          "name": "support.function.string.wibuscript",
          "match": "\\b(potongKoreNagasa|potongTeks|kiru|bikinGedeKore|dekaku|bikinKecilKore|chiisaku)\\b"
        },
        {
          "name": "support.function.rng.wibuscript",
          "match": "\\b(gachaPull|gacha)\\b"
        },
        {
          "name": "support.function.panic.wibuscript",
          "match": "\\b(yameteKudasai|yamete)\\b"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.wibuscript",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.wibuscript",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.wibuscript",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.wibuscript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
