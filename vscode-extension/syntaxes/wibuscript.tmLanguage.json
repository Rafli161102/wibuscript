{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WibuScript",
  "scopeName": "source.wibuscript",
  "fileTypes": [
    "wibu"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#support-functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(majiBener|maji|chigauBener|chigau|karappo|mu)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(moshi|kaloMoshi|soreTomo|tomo|hokaNo|hoka|ulangZutto|zutto|berhentiDuluKudasai|tomare|lanjutAksiSugi|tsugi)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(koreWa|kore)\\b"
        }
      ]
    },
    "support-functions": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(kasihMite|mite|bikinJutsu|jutsu|balikInDesu|balikinDesu|modoru|imaDesu|ima|gacha|nagasa|sujiNi|dekaku|chiisaku|tsuika|sakujo)\\b"
        }
      ]
    }
  }
}
