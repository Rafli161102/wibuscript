{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WibuScript",
  "scopeName": "source.wibuscript",
  "fileTypes": [
    "wibu"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#support-functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        },
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            },
            {
              "name": "variable.parameter",
              "match": "\\$\\{[^}]*\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(unjukkebolehan|keracunanmbg|menyalaAbkuh|kosongZannen|maafLancang|ladehBanh|majiBener|usoBanget|hontouNi|chigauYo|naniKore|blukutuk|munashi|hontou|maji|hon|uso|mu)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(persimpangan|yappingtolol|gasSampePagi|cobaDuluBanh|admindatang|summonJutsu|umpansilang|kaloGakGitu|yaudahlahYa|lanjutPart2|izintampil|soredemoNe|shoganaiNe|yameteKure|gomennasai|thugshaker|toriyoseru|sebarJutsu|ampunSepuh|sikatSemua|moShiKalo|zuttoLoop|ambatukam|yatteMiyo|begalbaju|ngawiland|sabarBanh|gasTesLur|santaiAja|soretomo|bijisatu|kokoromi|ragnamok|alasdaun|cocokkan|woijawa|tsugiNe|matteNe|amanBos|zenbuNe|kaloPas|kenaben|hyoujun|nyawit|yurusu|subete|koukai|shougo|sisaan|whenYh|karaNe|moshi|wowok|zutto|tsugi|matte|sore|hoka|yame|koko|yuru|sube|dari|tori|kara|baai|tsu|mat|kra|kou|sho|baa|hyo|mo|ho|zu|ya|no)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(watashiJutsu|kandabahlil|atarashiiNe|turunanDari|pokmipokmi|bundarahma|sektejomok|ambatumbas|kouhaiDesu|jalurhukum|kasihPaham|ambatunat|atarashii|lanangmas|hargaMati|paguyuban|bikinBaru|zettaiDa|fufufafa|iniDesu|haiBeri|umareta|keishou|oreSama|lahiran|zettai|mybini|nakama|tanjou|siImut|siAing|jutsu|kaesu|sekte|jibun|kore|kae|sek|tan|ata|kei|ko|ze|ju|ji)\\b"
        }
      ]
    },
    "support-functions": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(tolongCekNagasa|panjangberurat|monyetbanyumas|udahKelarinAja|kanjiMojiretsu|bungkusJsonLur|potongSebagian|naikinPangkat|jamBerapaBanh|jadiAngkaBanh|bikinJadiSuji|kumpulinBocah|matteNeSikit|ubahJadiDuit|danaterbakar|gakhabisgila|chiisaiVoice|copascaption|hutanselatan|goyangpantat|pedangdaging|bikinBarisan|kumpulinJawa|tsuyokuNare|kertaslecek|rudalmentah|nakamaTachi|tottekiteNe|salintempel|henshinSuru|morebullets|mitsuketaYo|menaracukur|pecahkepala|lendirmurni|sukoshiDake|seginiDoang|akarPangkat|bawahinBanh|uraiJsonLur|mputerNasib|salamkenal|cawapresin|nungguinLu|naniTypeNe|unmeiGacha|budakhitam|yomimasuNe|kakimasuNe|predikbola|senbatsuNe|irekaeruNe|akuntumbal|narabeteNe|tarikGacha|weeklypass|teriakAmba|mutlakBanh|atasinBanh|petainBanh|saringBanh|cariinBanh|kuchiMite|shibaraku|nanjiDesu|kopihitam|doreKurai|shakerbot|ookiVoice|shineeeYo|ototkawat|teksusang|mottekite|sikatBanh|SepongMas|wakattaYo|oshieteNe|mitsukeru|heihoukon|zettaichi|zettaiChi|shitaKiri|cukurfade|hairuKana|monyetijo|narabikae|bacotAmba|cekJamLur|cekUkuran|mutlakLur|pecahKata|gandengen|sulapKata|tumbalkan|omaeWaIu|imaJikan|priaotot|kiriteNe|chiisaku|fesnuker|ironiman|kiriSute|barabara|kirinuki|bawahLur|gantinen|potongen|punyaGak|cuplikno|spinZeus|suujiNi|haireNe|deteike|randamu|kanjiNi|robogor|kiriAge|tsunagu|isshoNi|kireeNi|akarLur|atasLur|bedahno|pecahin|lemKata|pangkas|rapihin|barisin|nagasa|shurui|omagot|marume|maneNi|ookiku|shikei|utsusu|ueKiri|okikae|fukumu|adaGak|urutno|ireta|retsu|ukeru|erabu|ruuto|bunri|tsuna|gacha|lemin|cukur|onora|comot|mite|iuYo|siba|naga|suji|beki|maru|toru|kiru|ooki|chii|yomu|kaku|yobu|mitu|kiri|fuku|nara|kinu|ima|suj|shu|bek|ire|ran|shi|ret|yoB|uke|kmj|utu|era|zet|kia|oki|kri|gac|mi|km|to|ki|yo|ka|kn|ru|ks|bu)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "(\\.\\.\\.|\\|\\||==|!=|<=|>=|=>|&&|\\+|\\*|<|>|!|-|/|%|=)"
        }
      ]
    }
  }
}
