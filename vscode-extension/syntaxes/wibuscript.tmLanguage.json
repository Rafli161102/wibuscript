{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WibuScript",
  "scopeName": "source.wibuscript",
  "fileTypes": [
    "wibu"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#support-functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        },
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            },
            {
              "name": "variable.parameter",
              "match": "\\$\\{[^}]*\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(hontou|hon|hontouNi|unjukkebolehan|uso|chigauYo|keracunanmbg|munashi|mu|naniKore|blukutuk|maji|majiBener|kara|kosongZannen)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(moshi|mo|moShiKalo|izintampil|soretomo|sore|soredemoNe|wowok|hoka|ho|shoganaiNe|woijawa|zutto|zu|zuttoLoop|nyawit|yame|ya|yameteKure|bijisatu|tsugi|tsu|tsugiNe|ambatukam|matte|mat|matteNe|admindatang|kokoromi|koko|yatteMiyo|ragnamok|yurusu|yuru|gomennasai|amanBos|subete|sube|zenbuNe|thugshaker|no|dari|alasdaun|toriyoseru|tori|summonJutsu|begalbaju|kara|kra|ngawiland|koukai|kou|sebarJutsu|umpansilang|shougo|sho|cocokkan|persimpangan|baai|baa|kaloPas|kenaben|hyoujun|hyo|sisaan|yappingtolol)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(kore|ko|iniDesu|pokmipokmi|zettai|ze|zettaiDa|bundarahma|jutsu|ju|mybini|fufufafa|kaesu|kae|haiBeri|kandabahlil|sekte|sek|nakama|sektejomok|tanjou|tan|umareta|ambatunat|atarashii|ata|atarashiiNe|ambatumbas|keishou|kei|kouhaiDesu|jalurhukum|jibun|ji|oreSama|lanangmas)\\b"
        }
      ]
    },
    "support-functions": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(mite|mi|iuYo|salamkenal|kuchiMite|km|omaeWaIu|cawapresin|shibaraku|siba|matteNeSikit|nungguinLu|imaJikan|ima|nanjiDesu|kopihitam|nagasa|naga|doreKurai|panjangberurat|suji|suj|suujiNi|ubahJadiDuit|shurui|shu|naniTypeNe|omagot|beki|bek|tsuyokuNare|naikinPangkat|marume|maru|maneNi|shakerbot|ireta|ire|haireNe|priaotot|toru|to|deteike|danaterbakar|kiru|ki|kiriteNe|kertaslecek|ookiku|ooki|ookiVoice|gakhabisgila|chiisaku|chii|chiisaiVoice|monyetbanyumas|randamu|ran|unmeiGacha|rudalmentah|shikei|shi|shineeeYo|udahKelarinAja|retsu|ret|nakamaTachi|budakhitam|yomu|yo|yomimasuNe|ototkawat|kaku|ka|kakimasuNe|teksusang|yobu|yoB|mottekite|sikatBanh|ukeru|uke|tottekiteNe|SepongMas|kanjiNi|kn|wakattaYo|salintempel|kanjiMojiretsu|kmj|oshieteNe|copascaption|utsusu|utu|henshinSuru|predikbola|erabu|era|senbatsuNe|morebullets|mitsukeru|mitu|mitsuketaYo|fesnuker|ruuto|ru|heihoukon|robogor|zettaichi|zet|zettaiChi|ironiman|kiriSute|ks|shitaKiri|hutanselatan|kiriAge|kia|ueKiri|menaracukur|bunri|bu|barabara|pecahkepala|tsunagu|tsuna|isshoNi|lendirmurni|okikae|oki|irekaeruNe|akuntumbal|kiri|kri|kireeNi|cukurfade|fukumu|fuku|hairuKana|monyetijo|narabikae|nara|narabeteNe|goyangpantat|kirinuki|kinu|sukoshiDake|pedangdaging|gacha|gac|tarikGacha|weeklypass)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "(==|!=|<=|>=|=>|<|>|&&|\\|\\||!|\\.\\.\\.|\\+|-|\\*|/|%|=)"
        }
      ]
    }
  }
}
