{
  "name": "wibuscript",
  "version": "1.3.0",
  "description": "Bahasa Pemrograman Esoterik WibuScript dengan Web Playground",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "wibu": "./dist/cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run core:build && next build",
    "prepack": "npm run core:build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "core:test": "tsx src/cli.ts contoh.wibu",
    "core:build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.cjs"
  },
  "files": [
    "dist",
    "examples",
    "contoh.wibu",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rafli161102/wibuscript.git"
  },
  "keywords": [
    "wibuscript",
    "esoteric-language",
    "interpreter",
    "nextjs",
    "typescript",
    "programming-language",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rafli161102/wibuscript/issues"
  },
  "homepage": "https://github.com/Rafli161102/wibuscript#readme",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0"
  }
}
